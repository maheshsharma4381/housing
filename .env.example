# Copy to .env.local and fill in real values. NEVER put real keys in this file — it is committed.

# Public site URL (used for auth redirect, email and WhatsApp links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase public configuration (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Database connection for `bun run db:migrate` only (local machine / CI secret, never in Vercel)
# Supabase → Project Settings → Database → Connection string → URI
SUPABASE_DB_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# Optional transactional email (Resend). Without these, use the WhatsApp share buttons.
RESEND_API_KEY=""
EMAIL_FROM="Sahvaas <noreply@your-domain.in>"

# Server-side only: used by the phone-notification sender (/api/push/send-pending). Never NEXT_PUBLIC_, never in this file.
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional: read uploaded vendor invoices automatically (server-side only, never NEXT_PUBLIC_).
# Set ONE of these in Vercel. Without a key the bill form stays manual.
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
# Only needed when both keys are set: "groq" or "anthropic"
INVOICE_PROVIDER=""
# Model override (defaults: groq qwen/qwen3.8-27b, anthropic claude-opus-5-5)
INVOICE_MODEL=""

# Optional: online payment of Sahvaas invoices (Razorpay). Server-only — never NEXT_PUBLIC_.
# Without these the Plan & Billing page shows bank-transfer details and the admin marks NEFT payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Random 32+ characters; save the same value in Platform -> Billing & Plans -> Online payments
SAHVAAS_GATEWAY_SECRET=""

# --- Phone notifications (web push, Phase 3A) ---
# Generate a key pair once:
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log(k.privateKey.export({type:'pkcs8',format:'pem'}));console.log(Buffer.from(k.publicKey.export({type:'spki',format:'der'})).subarray(-65).toString('base64url'))"
# VAPID_PRIVATE_KEY is the PEM (newlines as \n); NEXT_PUBLIC_VAPID_PUBLIC_KEY is the last line.
# VAPID_PRIVATE_KEY=""
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_SUBJECT="mailto:support@example.com"
# The push sender (/api/push/send-pending) needs SUPABASE_SERVICE_ROLE_KEY and this secret; pg_cron calls it
# when app.push_url and app.cron_secret are set on the database (see 030_notifications.sql).
# CRON_SECRET=""

# --- Mobile + WhatsApp code login (Phase 3C) ---
# Supabase dashboard -> Authentication -> Sign In / Providers -> Phone: enable.
# Authentication -> Hooks -> "Send SMS hook" (HTTP): URL https://<your-app>/api/auth/sms-hook; paste its secret here.
# The hook also needs SUPABASE_SERVICE_ROLE_KEY (above).
# SEND_SMS_HOOK_SECRET="v1,whsec_..."
# "whatsapp" (default once the WhatsApp keys are set) or "console" (development only: the code is printed in the server log)
# OTP_PROVIDER=""
# WhatsApp Cloud API: an approved AUTHENTICATION template with a copy-code button
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE_NAME=""
# WHATSAPP_TEMPLATE_LANG="en"
# Optional SMS backup for Indian numbers (MSG91, DLT-approved OTP template)
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# Show "Log in with mobile" on the login and signup pages ("1" once the hook works)
# NEXT_PUBLIC_PHONE_LOGIN=""
