# Copy to .env.local and fill in real values. NEVER put real keys in this file — it is committed.

# Public site URL (used for auth redirect, email and WhatsApp links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase public configuration (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Database connection for `bun run db:migrate` only (local machine / CI secret, never in Vercel)
# Supabase → Project Settings → Database → Connection string → URI
SUPABASE_DB_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# Optional transactional email (Resend). Without these, use the WhatsApp share buttons.
RESEND_API_KEY=""
EMAIL_FROM="Sahvaas <noreply@your-domain.in>"

# Not used by the app. Keep it out of Vercel and out of this file.
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional: read uploaded vendor invoices automatically (server-side only, never NEXT_PUBLIC_).
# Set ONE of these in Vercel. Without a key the bill form stays manual.
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
# Only needed when both keys are set: "groq" or "anthropic"
INVOICE_PROVIDER=""
# Model override (defaults: groq qwen/qwen3.8-27b, anthropic claude-opus-5-5)
INVOICE_MODEL=""

# Optional: online payment of Sahvaas invoices (Razorpay). Server-only — never NEXT_PUBLIC_.
# Without these the Plan & Billing page shows bank-transfer details and the admin marks NEFT payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Random 32+ characters; save the same value in Platform -> Billing & Plans -> Online payments
SAHVAAS_GATEWAY_SECRET=""
